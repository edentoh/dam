# --- Security ---
DAM_API_KEY=your_api_key_here
DAM_MAX_UPLOAD_BYTES=5242880
DAM_RATE_LIMIT_N=20
DAM_RATE_LIMIT_WINDOW=60

# --- Origins ---
DAM_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Ngrok (optional) ---
# Set true to auto-start ngrok tunnel when running scripts/app.py
DAM_NGROK_AUTOSTART=False
# Path to ngrok binary (or just "ngrok" if on PATH)
DAM_NGROK_BIN=ngrok
# Optional fixed ngrok domain URL (must be reserved in your ngrok account)
# Example: https://your-domain.ngrok-free.app
DAM_NGROK_URL=

# --- Main Model ---
DAM_DEVICE=cuda
DAM_MODEL_BACKBONE=convnextv2_tiny
DAM_MODEL_NUM_CLASSES=48
DAM_MODEL_PATH=runs/convnextv2_tiny_ms1/best.pth
DAM_MODEL_IMG_SIZE=420

# --- Thresholds ---
DAM_THRESHOLD_SCALAR=0.5
DAM_THRESHOLD_VECTOR_PATH=threshold_vector.json
DAM_REQUIRE_THRESHOLD_VECTOR=True

# --- Preprocessing ---
DAM_USE_CROP_TO_INK=True
DAM_CROP_PAD=12
DAM_CROP_MIN_SIZE=50

# --- Heuristic Gating ---
DAM_GATE_ENABLED=True
DAM_GATE_RETURN_METRICS=True
DAM_GATE_USE_TTA_FLIP=True
DAM_GATE_MIN_INK_FRAC=0.002
DAM_GATE_MAX_INK_FRAC=0.45

# --- ML Gating (Is-DAM) ---
DAM_IS_DAM_ENABLED=True
DAM_IS_DAM_RETURN_METRICS=False
DAM_IS_DAM_THRESHOLD=0.5
DAM_IS_DAM_MODEL_PATH=runs/is_dam_v1/best.pt
