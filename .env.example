DAM_API_KEY= your_api_key_here
DAM_MAX_UPLOAD_BYTES=10242880
DAM_RATE_LIMIT_N=20
DAM_RATE_LIMIT_WINDOW=60

# Multi-gate filtering (server-side)
# 1 = enabled, 0 = disabled
DAM_GATE_ENABLED=1

# Include gating metrics in API responses/errors (useful for debugging)
DAM_GATE_RETURN_METRICS=0

# Add a simple test-time augmentation stability gate (horizontal flip)
DAM_GATE_USE_TTA_FLIP=1

# Gate thresholds (defaults shown)
# DAM_GATE_MIN_INK_FRAC=0.002
# DAM_GATE_MAX_INK_FRAC=1.0
# DAM_GATE_MIN_MARGIN=0.03
# DAM_GATE_MAX_FLIP_L1=0.15
# DAM_GATE_MIN_SIDE_PX = 256
# DAM_GATE_MIN_MEAN_GRAY=90.0
# DAM_GATE_MIN_WHITE_FRAC=0.05
# DAM_GATE_MIN_EDGE_DENSITY=0.0005
# DAM_GATE_MIN_SOFT_PASSES=1

DAM_IS_DAM_ENABLED=1
DAM_IS_DAM_MODEL_PATH=runs/is_dam_v1/best.pt
DAM_IS_DAM_THRESHOLD=0.7